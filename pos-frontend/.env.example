# This is an example environment file for the POS frontend application
# Replace the values with your own configuration and rename the file to .env before running the application locally

# Auth0. Use the DishPatch POS application, not the provisioner application.
VITE_AUTH0_DOMAIN=dish-patch.au.auth0.com
VITE_AUTH0_AUDIENCE=https://pos.dish-patch
VITE_AUTH0_CLIENT_ID=tA0OZrCKWecFqypkUdbMxUc0F9WbLXgr

# Backend Integration
# VITE_BACKEND_URL is the URL of the backend API that the frontend will communicate with
VITE_BACKEND_URL=http://localhost:3000/

# Menu photos need no setting here. Each dish from the API carries its own imageUrl.