# This is an example environment file for the POS backend application
# Replace the values with your own configuration and rename the file to .env before running the application locally

# Replace the values with your own AWS credentials and region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# Auth0. Use the DishPatch POS application, not the provisioner application.
AUTH0_DOMAIN=dish-patch.au.auth0.com
AUTH0_AUDIENCE=https://pos.dish-patch
AUTH0_CLIENT_ID=tA0OZrCKWecFqypkUdbMxUc0F9WbLXgr

# DynabomoDB Integration
# Replace the values with your own DynamoDB table names
USERS_TABLE=dishpatch-pos-backend-Users
ORDERS_TABLE=dishpatch-pos-backend-Orders
PAYMENTS_TABLE=dishpatch-pos-backend-Payments
TABLES_TABLE=dishpatch-pos-backend-Tables
MENU_ITEMS_TABLE=dishpatch-pos-backend-MenuItems